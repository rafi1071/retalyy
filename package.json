{
  "name": "retalyy-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Retalyy monorepo: frontend on Cloudflare Pages and backend on Cloudflare Workers",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "typecheck": "npm run lint --workspace=frontend && npm run typecheck --workspace=backend",
    "deploy:backend": "npm run deploy --workspace=backend"
  },
  "keywords": [
    "retalyy",
    "cloudflare-pages",
    "cloudflare-workers",
    "hono",
    "vite",
    "react",
    "monorepo"
  ]
}

