{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "retalyymainbuild": {
      "root": "retalyy main build",
      "framework": "vite"
    },
    "retalyycrm": {
      "root": "retalyy crm",
      "framework": "vite"
    },
    "module_intake": {
      "root": "retalyy crm/module_intake",
      "framework": "vite"
    },
    "module_tx_processing": {
      "root": "retalyy crm/module_tx_processing",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "retalyymainbuild"
      }
    }
  ]
}
